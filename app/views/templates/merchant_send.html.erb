<% if @merchant.blank? %>
  <div class="max-w-xl mx-auto px-4 py-12">
    <div class="flex items-center gap-3 mb-6">
      <%= link_to template_path(@template), class: 'btn btn-ghost btn-sm' do %>
        <%= svg_icon('arrow_left', class: 'w-5 h-5') %>
        Back
      <% end %>
      <h1 class="text-2xl font-bold">Send "<%= @template.name %>"</h1>
    </div>
    <merchant-search
      data-search-url="<%= search_merchants_merchant_submissions_path %>"
      data-redirect-url="<%= merchant_send_template_path(@template) %>">
    </merchant-search>
  </div>
<% else %>
  <div class="sticky top-0 z-30 bg-primary/10 border-b border-primary/20 px-4 py-2">
    <div class="max-w-[1600px] mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="font-semibold"><%= @merchant_name %></span>
        <span class="text-sm opacity-60"><%= @merchant_email %></span>
        <a href="<%= merchant_send_template_path(@template) %>" class="btn btn-ghost btn-xs">Change</a>
      </div>
      <form action="<%= merchant_submissions_path %>" method="post" id="merchant-send-form">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
        <input type="hidden" name="template_id" value="<%= @template.id %>" />
        <input type="hidden" name="merchant_id" value="<%= @merchant_id %>" />
        <input type="hidden" name="merchant_name" value="<%= @merchant_name %>" />
        <input type="hidden" name="merchant_email" value="<%= @merchant_email %>" />
        <% @data_paths.each do |field_name, data_path| %>
          <input type="hidden" name="data_paths[<%= field_name %>]" value="<%= data_path %>" />
        <% end %>
        <% @agent_only_fields.each do |field_name| %>
          <input type="hidden" name="agent_only_fields[]" value="<%= field_name %>" />
        <% end %>
        <% submitter_roles = @template.submitters %>
        <% if submitter_roles.size > 1 %>
          <div class="mb-2">
            <p class="text-xs font-semibold mb-2 opacity-70">Recipients</p>
            <div class="grid gap-3" style="grid-template-columns: repeat(<%= submitter_roles.size %>, minmax(0, 1fr));">
              <% submitter_roles.each_with_index do |role, idx| %>
                <div class="bg-base-100/60 rounded-lg p-2">
                  <input type="hidden" name="submitters[<%= idx %>][uuid]" value="<%= role['uuid'] %>" />
                  <p class="text-xs font-semibold mb-1"><%= role['name'] %></p>
                  <input type="text" name="submitters[<%= idx %>][name]" placeholder="Name"
                    value="<%= idx == 0 ? @merchant_name : '' %>"
                    class="input input-bordered input-xs w-full mb-1" />
                  <input type="email" name="submitters[<%= idx %>][email]" placeholder="Email" required
                    value="<%= idx == 0 ? @merchant_email : '' %>"
                    class="input input-bordered input-xs w-full" />
                </div>
              <% end %>
            </div>
            <label class="flex items-center gap-2 cursor-pointer mt-2">
              <input type="checkbox" name="preserve_order" value="1" checked class="checkbox checkbox-xs" />
              <span class="text-xs">Preserve signing order</span>
            </label>
          </div>
        <% else %>
          <input type="hidden" name="submitters[0][uuid]" value="<%= submitter_roles.first['uuid'] %>" />
          <input type="hidden" name="submitters[0][name]" value="<%= @merchant_name %>" />
          <input type="hidden" name="submitters[0][email]" value="<%= @merchant_email %>" />
        <% end %>
        <div id="merchant-field-values-container">
          <% @field_values.each do |field_name, value| %>
            <input type="hidden" name="field_values[<%= field_name %>]" value="<%= value %>" data-field-name="<%= field_name %>" />
          <% end %>
        </div>
        <div class="flex items-center gap-3">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="send_email" value="1" checked class="checkbox checkbox-sm" />
            <span class="text-sm">Send email</span>
          </label>
          <button type="submit" class="btn btn-primary btn-sm" onclick="collectFieldValues(event)">
            Send for Signature
          </button>
        </div>
      </form>
    </div>
  </div>

  <template-builder
    class="grid"
    data-template="<%= @template_data %>"
    data-autosave="false"
    data-with-save-button="false"
    data-with-send-button="false"
    data-with-sign-yourself-button="false"
    data-with-fields-detection="false"
    data-default-fields="<%= MerchantFieldMapper.portal_fields_for_builder.to_json %>"
    data-locale="<%= I18n.locale %>"
  ></template-builder>

  <script>
    function collectFieldValues(event) {
      event.preventDefault();

      var container = document.getElementById('merchant-field-values-container');
      var fieldValues = {};

      // Start with server-side pre-populated values (baseline)
      container.querySelectorAll('input[data-field-name]').forEach(function(input) {
        fieldValues[input.getAttribute('data-field-name')] = input.value;
      });

      // Override with any edits made in the builder (live Vue component state)
      try {
        var builderEl = document.querySelector('template-builder');
        if (builderEl && builderEl.component) {
          var fields = builderEl.component.template.fields || [];
          fields.forEach(function(f) {
            if (f.name) {
              if (f.default_value != null && f.default_value !== '') {
                fieldValues[f.name] = f.default_value;
              } else if (!(f.name in fieldValues)) {
                // Field exists in builder but has no value — don't override server value
              }
            }
          });
        }
      } catch(e) {
        console.warn('[MerchantSend] Could not read builder fields:', e);
      }

      // Rebuild hidden inputs with final merged values
      container.innerHTML = '';
      Object.keys(fieldValues).forEach(function(name) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'field_values[' + name + ']';
        input.value = String(fieldValues[name]);
        container.appendChild(input);
      });

      document.getElementById('merchant-send-form').submit();
    }
  </script>
<% end %>
