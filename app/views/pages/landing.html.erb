<%= content_for(:html_title, 'Split Signature | Professional Document Signing') %>

<%# ===== HERO ===== %>
<div class="text-center pt-16 pb-20 md:pt-24 md:pb-28">
  <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-tight">
    Document signing,<br class="hidden md:inline"> done right.
  </h1>
  <p class="mt-5 text-lg text-gray-500 max-w-lg mx-auto">
    Send, sign, and manage legally binding documents in minutes.
    Fast, secure, and built for teams that move quickly.
  </p>
  <div class="mt-8">
    <%= link_to new_user_session_path, class: 'btn btn-accent text-white px-8' do %>
      Get Started
      <%= svg_icon('arrow_right', class: 'w-5 h-5 ml-1') %>
    <% end %>
  </div>
</div>

<%# ===== TRUST SIGNALS ===== %>
<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 pb-16 text-sm text-gray-400">
  <span class="flex items-center gap-1.5">
    <%= svg_icon('shield_check', class: 'w-4 h-4') %>
    Bank-grade encryption
  </span>
  <span class="flex items-center gap-1.5">
    <%= svg_icon('certificate', class: 'w-4 h-4') %>
    Legally binding
  </span>
  <span class="flex items-center gap-1.5">
    <%= svg_icon('devices', class: 'w-4 h-4') %>
    Any device
  </span>
  <span class="flex items-center gap-1.5">
    <%= svg_icon('clock', class: 'w-4 h-4') %>
    Full audit trail
  </span>
</div>

<div class="border-t border-base-300"></div>

<%# ===== FEATURES ===== %>
<div id="features" class="pt-16 pb-20 md:pt-20 md:pb-24">
  <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">
    Everything you need to close deals faster
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <div class="card bg-base-200">
      <div class="card-body p-6">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-9 h-9 rounded-lg" style="background-color: #FFF0EB;">
            <%= svg_icon('writing_sign', class: 'w-5 h-5 text-accent') %>
          </span>
          <h3 class="font-bold">E-Signatures</h3>
        </div>
        <p class="text-gray-500 text-sm leading-relaxed">
          Collect legally binding signatures from anyone. Signers draw, type, or upload from any device.
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body p-6">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-9 h-9 rounded-lg" style="background-color: #FFF0EB;">
            <%= svg_icon('forms', class: 'w-5 h-5 text-accent') %>
          </span>
          <h3 class="font-bold">Reusable Templates</h3>
        </div>
        <p class="text-gray-500 text-sm leading-relaxed">
          Upload documents once, reuse forever. Add signature fields, text inputs, dates, and more.
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body p-6">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-9 h-9 rounded-lg" style="background-color: #FFF0EB;">
            <%= svg_icon('send', class: 'w-5 h-5 text-accent') %>
          </span>
          <h3 class="font-bold">Automated Sending</h3>
        </div>
        <p class="text-gray-500 text-sm leading-relaxed">
          Send to multiple signers with automatic notifications, reminders, and completion tracking.
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body p-6">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-9 h-9 rounded-lg" style="background-color: #FFF0EB;">
            <%= svg_icon('lock', class: 'w-5 h-5 text-accent') %>
          </span>
          <h3 class="font-bold">Secure & Compliant</h3>
        </div>
        <p class="text-gray-500 text-sm leading-relaxed">
          Every document is encrypted with a tamper-proof audit trail, timestamps, and IP verification.
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body p-6">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-9 h-9 rounded-lg" style="background-color: #FFF0EB;">
            <%= svg_icon('api', class: 'w-5 h-5 text-accent') %>
          </span>
          <h3 class="font-bold">Developer API</h3>
        </div>
        <p class="text-gray-500 text-sm leading-relaxed">
          Integrate signing into your app with a full REST API and webhook notifications.
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body p-6">
        <div class="flex items-center gap-3 mb-3">
          <span class="flex items-center justify-center w-9 h-9 rounded-lg" style="background-color: #FFF0EB;">
            <%= svg_icon('devices', class: 'w-5 h-5 text-accent') %>
          </span>
          <h3 class="font-bold">Mobile Optimized</h3>
        </div>
        <p class="text-gray-500 text-sm leading-relaxed">
          Review and sign on any phone, tablet, or desktop. No app download required.
        </p>
      </div>
    </div>
  </div>
</div>

<div class="border-t border-base-300"></div>

<%# ===== HOW IT WORKS ===== %>
<div class="pt-16 pb-20 md:pt-20 md:pb-24">
  <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">
    Three steps to a signed document
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-3xl mx-auto">
    <div class="text-center">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent text-white text-lg font-bold mb-4">1</div>
      <h3 class="font-bold mb-1">Upload</h3>
      <p class="text-gray-500 text-sm">Upload a PDF and drag-and-drop fields where you need them.</p>
    </div>
    <div class="text-center">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent text-white text-lg font-bold mb-4">2</div>
      <h3 class="font-bold mb-1">Send</h3>
      <p class="text-gray-500 text-sm">Add your signers and send. They get a secure link to sign.</p>
    </div>
    <div class="text-center">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent text-white text-lg font-bold mb-4">3</div>
      <h3 class="font-bold mb-1">Done</h3>
      <p class="text-gray-500 text-sm">Everyone gets a signed copy with an audit trail attached.</p>
    </div>
  </div>
</div>

<div class="border-t border-base-300"></div>

<%# ===== CTA ===== %>
<div class="text-center py-16 md:py-20">
  <h2 class="text-2xl md:text-3xl font-bold">Ready to get started?</h2>
  <p class="mt-3 text-gray-500">Sign in to start sending documents for signature.</p>
  <div class="mt-6">
    <%= link_to new_user_session_path, class: 'btn btn-accent text-white px-8' do %>
      Get Started
      <%= svg_icon('arrow_right', class: 'w-5 h-5 ml-1') %>
    <% end %>
  </div>
</div>

<%# ===== FOOTER ===== %>
<div class="border-t border-base-300 pt-6 pb-2 flex flex-col md:flex-row items-center justify-between gap-3 text-sm text-gray-400">
  <span>&copy; <%= Date.current.year %> Split LLC</span>
  <div class="flex items-center gap-5">
    <a href="/docs/api" class="hover:text-gray-600">API Docs</a>
    <a href="mailto:<%= Docuseal::SUPPORT_EMAIL %>" class="hover:text-gray-600">Contact</a>
  </div>
</div>
