<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow max-w-xl mx-auto">
    <p class="text-4xl font-bold mb-4">Company Information</p>

    <%= form_with url: settings_company_path, method: :patch, local: true do |f| %>
      <div class="space-y-3">
        <div class="form-control">
          <label class="label"><span class="label-text font-semibold">Business Name</span></label>
          <input type="text" name="company_info[business_name]" value="<%= @company_info['business_name'] %>" class="input input-bordered w-full" />
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text font-semibold">DBA Name</span></label>
          <input type="text" name="company_info[dba_name]" value="<%= @company_info['dba_name'] %>" class="input input-bordered w-full" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">EIN</span></label>
            <input type="text" name="company_info[ein]" value="<%= @company_info['ein'] %>" class="input input-bordered w-full" />
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">Company Type</span></label>
            <input type="text" name="company_info[company_type]" value="<%= @company_info['company_type'] %>" class="input input-bordered w-full" />
          </div>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text font-semibold">Product Description</span></label>
          <input type="text" name="company_info[product_description]" value="<%= @company_info['product_description'] %>" class="input input-bordered w-full" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">Phone</span></label>
            <input type="text" name="company_info[phone]" value="<%= @company_info['phone'] %>" class="input input-bordered w-full" />
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">Email</span></label>
            <input type="email" name="company_info[email]" value="<%= @company_info['email'] %>" class="input input-bordered w-full" />
          </div>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text font-semibold">Street Address</span></label>
          <input type="text" name="company_info[street]" value="<%= @company_info['street'] %>" class="input input-bordered w-full" />
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">City</span></label>
            <input type="text" name="company_info[city]" value="<%= @company_info['city'] %>" class="input input-bordered w-full" />
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">State</span></label>
            <input type="text" name="company_info[state]" value="<%= @company_info['state'] %>" class="input input-bordered w-full" />
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">Zip</span></label>
            <input type="text" name="company_info[zip]" value="<%= @company_info['zip'] %>" class="input input-bordered w-full" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">Business Start Date</span></label>
            <input type="text" name="company_info[business_start_date]" value="<%= @company_info['business_start_date'] %>" class="input input-bordered w-full" placeholder="YYYY-MM-DD" />
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">Website</span></label>
            <input type="text" name="company_info[website]" value="<%= @company_info['website'] %>" class="input input-bordered w-full" />
          </div>
        </div>
      </div>

      <p class="text-4xl font-bold mb-4 mt-8">Principals</p>

      <div id="principals-container" class="space-y-6">
        <% @principals.each_with_index do |principal, idx| %>
          <div class="card bg-base-200 p-4" data-principal-index="<%= idx %>">
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-bold text-lg"><%= principal['first_name'] %> <%= principal['last_name'] %></h3>
              <% if @principals.size > 1 %>
                <button type="button" class="btn btn-ghost btn-sm text-error" onclick="this.closest('[data-principal-index]').remove()">Remove</button>
              <% end %>
            </div>
            <input type="hidden" name="principals[<%= idx %>][id]" value="<%= principal['id'] %>" />
            <div class="grid grid-cols-2 gap-3">
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">First Name</span></label>
                <input type="text" name="principals[<%= idx %>][first_name]" value="<%= principal['first_name'] %>" class="input input-bordered w-full" />
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Last Name</span></label>
                <input type="text" name="principals[<%= idx %>][last_name]" value="<%= principal['last_name'] %>" class="input input-bordered w-full" />
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3 mt-2">
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Title</span></label>
                <input type="text" name="principals[<%= idx %>][title]" value="<%= principal['title'] %>" class="input input-bordered w-full" />
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Ownership %</span></label>
                <input type="number" name="principals[<%= idx %>][ownership_pct]" value="<%= principal['ownership_pct'] %>" class="input input-bordered w-full" min="0" max="100" />
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3 mt-2">
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Email</span></label>
                <input type="email" name="principals[<%= idx %>][email]" value="<%= principal['email'] %>" class="input input-bordered w-full" />
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Phone</span></label>
                <input type="text" name="principals[<%= idx %>][phone]" value="<%= principal['phone'] %>" class="input input-bordered w-full" />
              </div>
            </div>
            <div class="grid grid-cols-3 gap-3 mt-2">
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">SSN</span></label>
                <input type="text" name="principals[<%= idx %>][ssn]" value="<%= principal['ssn'] %>" class="input input-bordered w-full" />
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Date of Birth</span></label>
                <input type="text" name="principals[<%= idx %>][dob]" value="<%= principal['dob'] %>" class="input input-bordered w-full" placeholder="YYYY-MM-DD" />
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">DL #</span></label>
                <input type="text" name="principals[<%= idx %>][drivers_license_number]" value="<%= principal['drivers_license_number'] %>" class="input input-bordered w-full" />
              </div>
            </div>
            <div class="form-control mt-2">
              <label class="label"><span class="label-text font-semibold">DL State</span></label>
              <input type="text" name="principals[<%= idx %>][drivers_license_state]" value="<%= principal['drivers_license_state'] %>" class="input input-bordered w-full max-w-[100px]" />
            </div>
            <div class="form-control mt-2">
              <label class="label"><span class="label-text font-semibold">Street Address</span></label>
              <input type="text" name="principals[<%= idx %>][street]" value="<%= principal['street'] %>" class="input input-bordered w-full" />
            </div>
            <div class="grid grid-cols-3 gap-3 mt-2">
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">City</span></label>
                <input type="text" name="principals[<%= idx %>][city]" value="<%= principal['city'] %>" class="input input-bordered w-full" />
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">State</span></label>
                <input type="text" name="principals[<%= idx %>][state]" value="<%= principal['state'] %>" class="input input-bordered w-full" />
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text font-semibold">Zip</span></label>
                <input type="text" name="principals[<%= idx %>][zip]" value="<%= principal['zip'] %>" class="input input-bordered w-full" />
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-6">
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    <% end %>
  </div>
  <div class="w-0 md:w-52"></div>
</div>
