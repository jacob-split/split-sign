<div class="max-w-7xl mx-auto px-4 py-6">
  <merchant-submission data-search-url="<%= search_merchants_merchant_submissions_path %>"
                       data-preview-url="<%= preview_merchant_submissions_path %>">

    <%# Section 1: Template & Merchant Selection %>
    <div data-ref="selectionSection">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-3xl font-bold">Send to Merchant</h1>
        <a href="<%= @template ? template_path(@template) : root_path %>" class="btn btn-ghost btn-sm">
          <%= svg_icon('arrow_left', class: 'w-5 h-5') %>
          Back
        </a>
      </div>

      <div class="card bg-base-100 border border-base-300">
        <div class="card-body">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <%# Template Selection %>
            <div class="form-control">
              <label class="label">
                <span class="label-text font-medium">Template</span>
              </label>
              <select class="select select-bordered w-full" data-ref="templateSelect">
                <option value="">Select a template...</option>
                <% @templates.each do |t| %>
                  <option value="<%= t.id %>" <%= 'selected' if @template&.id == t.id %>>
                    <%= t.name %>
                  </option>
                <% end %>
              </select>
            </div>

            <%# Merchant Search %>
            <div class="form-control">
              <label class="label">
                <span class="label-text font-medium">Merchant</span>
              </label>
              <div class="relative">
                <input type="text"
                       placeholder="Search by business name or email..."
                       class="input input-bordered w-full"
                       data-ref="searchInput"
                       autocomplete="off" />
                <div class="absolute z-20 w-full mt-1 bg-base-100 border border-base-300 rounded-lg shadow-lg hidden max-h-60 overflow-y-auto"
                     data-ref="searchResults">
                </div>
              </div>
            </div>
          </div>

          <%# Selected merchant info %>
          <div class="hidden mt-4 p-3 bg-base-200 rounded-lg" data-ref="merchantInfo">
            <div class="flex items-center justify-between">
              <div>
                <span class="font-medium" data-ref="merchantNameDisplay"></span>
                <span class="text-sm opacity-60 ml-2" data-ref="merchantEmailDisplay"></span>
              </div>
              <button type="button" class="btn btn-ghost btn-xs" data-ref="clearButton">
                Change
              </button>
            </div>
          </div>

          <div class="mt-4 flex justify-end">
            <button type="button" class="btn btn-neutral btn-sm" data-ref="loadButton" disabled>
              Load Fields
            </button>
          </div>
        </div>
      </div>
    </div>

    <%# Section 2: Summary Bar + Two-Column Field Review (hidden until fields load) %>
    <div class="hidden" data-ref="fieldsSection">
      <%# Summary bar %>
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-4">
          <h1 class="text-2xl font-semibold" data-ref="summaryTemplateName"></h1>
        </div>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2 text-sm">
            <%= svg_icon('user', class: 'w-4 h-4 opacity-50') %>
            <span class="font-medium" data-ref="summaryMerchantName"></span>
            <span class="opacity-50" data-ref="summaryMerchantEmail"></span>
          </div>
          <span class="badge badge-neutral badge-outline badge-sm" data-ref="fieldCount"></span>
          <button type="button" class="btn btn-ghost btn-xs" data-ref="changeButton">Change</button>
        </div>
      </div>

      <%# Two-column layout %>
      <div class="flex flex-col md:flex-row gap-4" style="height: calc(100vh - 260px); min-height: 400px;">
        <%# Left: Document Preview %>
        <div class="flex-1 overflow-y-auto md:pr-2" data-ref="documentPreview">
          <div class="space-y-3" data-ref="documentPages">
          </div>
        </div>

        <%# Right: Field List %>
        <div class="md:w-80 md:flex-none overflow-y-auto" data-ref="fieldsListPanel">
          <div class="space-y-1.5" data-ref="fieldsBody">
          </div>
        </div>
      </div>
    </div>

    <%# Section 3: Send %>
    <div class="mt-4 hidden" data-ref="sendSection">
      <form action="<%= merchant_submissions_path %>" method="post">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
        <input type="hidden" name="template_id" data-ref="formTemplateId" />
        <input type="hidden" name="merchant_id" data-ref="formMerchantId" />
        <input type="hidden" name="merchant_name" data-ref="formMerchantName" />
        <input type="hidden" name="merchant_email" data-ref="formMerchantEmail" />
        <div data-ref="formFieldsContainer"></div>

        <div class="flex items-center justify-between py-3">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="send_email" value="1" checked class="checkbox checkbox-sm" />
            <span class="text-sm">Send email invitation</span>
          </label>
          <button type="submit" class="btn btn-primary">
            <%= svg_icon('send', class: 'w-5 h-5') %>
            Send for Signature
          </button>
        </div>
      </form>
    </div>

    <%# Error display %>
    <div class="alert alert-error mt-4 hidden" data-ref="errorAlert">
      <span data-ref="errorMessage"></span>
    </div>
  </merchant-submission>
</div>
