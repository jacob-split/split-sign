<div class="max-w-4xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold">Send to Merchant</h1>
    <a href="<%= @template ? template_path(@template) : root_path %>" class="btn btn-ghost btn-sm">
      <%= svg_icon('arrow_left', class: 'w-5 h-5') %>
      Back
    </a>
  </div>

  <merchant-submission data-search-url="<%= search_merchants_merchant_submissions_path %>"
                       data-preview-url="<%= preview_merchant_submissions_path %>">

    <%# Section 1: Template & Merchant Selection %>
    <div class="card bg-base-100 border border-base-300 mb-4">
      <div class="card-body">
        <h2 class="card-title text-lg mb-4">
          <%= svg_icon('file_text', class: 'w-5 h-5') %>
          Template & Merchant
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%# Template Selection %>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">Template</span>
            </label>
            <select class="select select-bordered w-full" data-ref="templateSelect">
              <option value="">Select a template...</option>
              <% @templates.each do |t| %>
                <option value="<%= t.id %>" <%= 'selected' if @template&.id == t.id %>>
                  <%= t.name %>
                </option>
              <% end %>
            </select>
          </div>

          <%# Merchant Search %>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">Merchant</span>
            </label>
            <div class="relative">
              <input type="text"
                     placeholder="Search by business name or email..."
                     class="input input-bordered w-full"
                     data-ref="searchInput"
                     autocomplete="off" />
              <div class="absolute z-20 w-full mt-1 bg-base-100 border border-base-300 rounded-lg shadow-lg hidden max-h-60 overflow-y-auto"
                   data-ref="searchResults">
              </div>
            </div>
          </div>
        </div>

        <%# Selected merchant info %>
        <div class="hidden mt-4 p-3 bg-base-200 rounded-lg" data-ref="merchantInfo">
          <div class="flex items-center justify-between">
            <div>
              <span class="font-medium" data-ref="merchantNameDisplay"></span>
              <span class="text-sm opacity-60 ml-2" data-ref="merchantEmailDisplay"></span>
            </div>
            <button type="button" class="btn btn-ghost btn-xs" data-ref="clearButton">
              Change
            </button>
          </div>
        </div>

        <div class="mt-4 flex justify-end">
          <button type="button" class="btn btn-neutral btn-sm" data-ref="loadButton" disabled>
            <%= svg_icon('reload', class: 'w-4 h-4') %>
            Load Fields
          </button>
        </div>
      </div>
    </div>

    <%# Section 2: Field Review & Edit %>
    <div class="card bg-base-100 border border-base-300 mb-4 hidden" data-ref="fieldsSection">
      <div class="card-body">
        <div class="flex items-center justify-between mb-4">
          <h2 class="card-title text-lg">
            <%= svg_icon('list', class: 'w-5 h-5') %>
            Review Fields
          </h2>
          <span class="badge badge-neutral badge-outline" data-ref="fieldCount"></span>
        </div>

        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr>
                <th class="w-1/3">Field Name</th>
                <th>Value</th>
              </tr>
            </thead>
            <tbody data-ref="fieldsBody">
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%# Section 3: Send %>
    <div class="card bg-base-100 border border-base-300 hidden" data-ref="sendSection">
      <div class="card-body">
        <h2 class="card-title text-lg mb-4">
          <%= svg_icon('send', class: 'w-5 h-5') %>
          Send for Signature
        </h2>

        <form action="<%= merchant_submissions_path %>" method="post">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
          <input type="hidden" name="template_id" data-ref="formTemplateId" />
          <input type="hidden" name="merchant_id" data-ref="formMerchantId" />
          <input type="hidden" name="merchant_name" data-ref="formMerchantName" />
          <input type="hidden" name="merchant_email" data-ref="formMerchantEmail" />
          <div data-ref="formFieldsContainer"></div>

          <div class="bg-base-200 rounded-lg p-4 mb-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
              <div>
                <span class="opacity-60">Sending to:</span>
                <span class="font-medium" data-ref="sendMerchantName"></span>
              </div>
              <div>
                <span class="opacity-60">Email:</span>
                <span class="font-medium" data-ref="sendMerchantEmail"></span>
              </div>
              <div>
                <span class="opacity-60">Template:</span>
                <span class="font-medium" data-ref="sendTemplateName"></span>
              </div>
            </div>
          </div>

          <div class="form-control mb-4">
            <label class="label cursor-pointer justify-start gap-2">
              <input type="checkbox" name="send_email" value="1" checked class="checkbox checkbox-sm" />
              <span class="label-text">Send email invitation to merchant</span>
            </label>
          </div>

          <div class="flex justify-end">
            <button type="submit" class="btn btn-primary">
              <%= svg_icon('send', class: 'w-5 h-5') %>
              Send for Signature
            </button>
          </div>
        </form>
      </div>
    </div>

    <%# Error display %>
    <div class="alert alert-error mt-4 hidden" data-ref="errorAlert">
      <span data-ref="errorMessage"></span>
    </div>
  </merchant-submission>
</div>
