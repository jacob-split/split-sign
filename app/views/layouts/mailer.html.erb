<!DOCTYPE html>
<html>
  <head>
    <title></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style></style>
  </head>
  <body dir="<%= TextUtils.rtl?(yield) ? 'rtl' : 'auto' %>" style="margin: 0; padding: 0; background-color: #f5f5f5; -webkit-font-smoothing: antialiased;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f5f5f5;">
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%;">
            <!-- Logo -->
            <tr>
              <td align="center" style="padding-bottom: 24px;">
                <img src="https://sign.split-llc.com/logo-split.png?v=4" alt="Split Signature" width="160" style="display: block; max-width: 160px; height: auto;">
              </td>
            </tr>
            <!-- Content Card -->
            <tr>
              <td style="background-color: #ffffff; border-radius: 8px; padding: 32px 40px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #333333;">
                <%= yield %>
              </td>
            </tr>
            <!-- Footer -->
            <tr>
              <td align="center" style="padding-top: 24px;">
                <%= render partial: 'shared/mailer_attribution' %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
