<%= content_for(:canonical_url, new_user_session_url) %>

<div class="flex items-center justify-center min-h-[70vh]">
  <div class="w-full max-w-md px-4">
    <%# Sign-in card %>
    <div class="bg-base-100 rounded-2xl shadow-lg border border-base-300 p-8 md:p-10">

      <%# Logo and heading %>
      <div class="text-center mb-8">
        <div class="flex justify-center mb-5">
          <%= render 'shared/logo', width: '52', height: '52' %>
        </div>
        <h1 class="text-2xl font-bold">Sign In</h1>
        <p class="text-gray-400 text-sm mt-2">Welcome back to Split Signature</p>
      </div>

      <div class="space-y-3">
        <%= form_for '', url: omniauth_authorize_path(:user, :google_oauth2), data: { turbo: false }, method: :post do |f| %>
          <%= f.button button_title(title: 'Sign in with Google', icon: svg_icon('brand_google', class: 'w-5 h-5')), class: 'white-button w-full' %>
        <% end %>
      </div>

    </div>
  </div>
</div>
