<%= content_for(:canonical_url, new_user_session_url) %>

<div class="flex items-center justify-center min-h-[70vh]">
  <div class="w-full max-w-md px-4">
    <%# Sign-in card %>
    <div class="bg-base-100 rounded-2xl shadow-lg border border-base-300 p-8 md:p-10">

      <%# Logo and heading %>
      <div class="text-center mb-8">
        <div class="flex justify-center mb-5">
          <%= render 'shared/logo', width: '52', height: '52' %>
        </div>
        <h1 class="text-2xl font-bold"><%= t('sign_in') %></h1>
        <p class="text-gray-400 text-sm mt-2">Welcome back to Split Signature</p>
      </div>

      <%= render 'devise/shared/select_server' if Docuseal.multitenant? %>

      <%= form_for(resource, as: resource_name, html: { class: 'space-y-5' }, data: { turbo: params[:redir].blank? }, url: session_path(resource_name)) do |f| %>
        <%= render 'hidden_fields' %>
        <div class="space-y-4" dir="auto">
          <div class="form-control">
            <%= f.label :email, t(:email), class: 'label text-sm font-medium' %>
            <%= f.email_field :email, autofocus: true, autocomplete: 'email', placeholder: 'you@company.com', class: 'base-input w-full' %>
          </div>
          <div class="form-control">
            <div class="flex items-center justify-between">
              <%= f.label :password, t(:password), class: 'label text-sm font-medium' %>
              <%- if devise_mapping.recoverable? %>
                <%= link_to t('forgot_your_password_'), new_password_path(resource_name, { lang: params[:lang] }.compact_blank), class: 'text-xs text-accent hover:underline' %>
              <% end %>
            </div>
            <%= f.password_field :password, autocomplete: 'current-password', class: 'base-input w-full' %>
          </div>
        </div>
        <div class="form-control pt-2">
          <%= f.button button_title(title: t(:sign_in), disabled_with: t(:signing_in)), class: 'base-button w-full' %>
        </div>
      <% end %>

      <% if devise_mapping.omniauthable? %>
        <% if User.omniauth_providers.any? %>
          <div class="divider text-xs text-gray-400 my-6">OR</div>
        <% end %>
        <div class="space-y-3">
          <% if User.omniauth_providers.include?(:google_oauth2) %>
            <%= form_for '', url: omniauth_authorize_path(resource_name, :google_oauth2), data: { turbo: false }, method: :post do |f| %>
              <set-timezone data-input-id="state" data-params="true"></set-timezone>
              <%= hidden_field_tag :state, { redir: params[:redir].to_s }.compact_blank.to_query %>
              <%= f.button button_title(title: t('sign_in_with_google'), icon: svg_icon('brand_google', class: 'w-5 h-5')), class: 'white-button w-full' %>
            <% end %>
          <% end %>
          <% if User.omniauth_providers.include?(:microsoft_office365) %>
            <%= form_for '', url: omniauth_authorize_path(resource_name, :microsoft_office365), data: { turbo: false }, method: :post do |f| %>
              <set-timezone data-input-id="state_microsoft" data-params="true"></set-timezone>
              <%= hidden_field_tag :state, { redir: params[:redir].to_s }.compact_blank.to_query, id: 'state_microsoft' %>
              <%= f.button button_title(title: t('sign_in_with_microsoft'), icon: svg_icon('brand_microsoft', class: 'w-5 h-5')), class: 'white-button w-full' %>
            <% end %>
          <% end %>
        </div>
      <% end %>

    </div>

    <%# Links below the card %>
    <div class="text-center mt-6 space-y-4">
      <%- if devise_mapping.registerable? %>
        <p class="text-sm text-gray-500">
          <%= t('dont_have_an_account') rescue "Don't have an account?" %>
          <%= link_to t('create_free_account'), registration_path({ redir: params[:redir], lang: params[:lang] }.compact_blank), class: 'font-semibold text-accent hover:underline capitalize' %>
        </p>
      <% end %>

      <div>
        <%= form_with url: url_for, method: :get do %>
          <% if params[:redir].present? %>
            <%= hidden_field_tag :redir, params[:redir] %>
          <% end %>
          <submit-form data-on="change">
            <%= select_tag :lang, options_for_select((I18n.available_locales - %i[en pt-PT de-DE fr-FR it-IT es-ES nl-NL]).map { |code| [t("language_#{code}"), code] }, I18n.locale), class: 'select select-sm border-base-content/30 text-sm' %>
          </submit-form>
        <% end %>
      </div>
    </div>
  </div>
</div>
